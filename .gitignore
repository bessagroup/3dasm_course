# Ignore all files in the following folders:
STUFF_NOT_TO_UPLOAD/
# ignore ipynb checkpoints:
.ipynb_checkpoints
# ignore files inside some subfolders to be used by students
**/your_data/*
**/your_Assignments/*
# the instructions file that a lecture notebook writes for its agents (the notebook is the source of truth)
Lectures/Lecture*/CLAUDE.md
# the task folders where the agents of a lecture work (each student runs their own)
**/agent_work/
# but do not ignore the placeholder file such that some folders exist for students, yet remain empty
!.gitkeep

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

Untitled.ipynb

# draw.io desktop writes a dot-prefixed backup next to the file it is editing
.$*.drawio.bkp
*.drawio.bkp

# macOS + JupyterLab local state, never part of the course material
.DS_Store
.jupyter/
.jupyter_ystore.db
.virtual_documents/
